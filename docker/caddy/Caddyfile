{
	auto_https off
	servers {
		# Who may tell Caddy the real client address and scheme (X-Forwarded-*): the Apache proxy.
		# Private networks by default; see CADDY_TRUSTED_PROXIES in .env.example.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
	}
}

:80 {
	root * /var/www/html/public
	encode zstd gzip
	request_body {
		max_size 110MB
	}

	# Vite assets are content-hashed and photos have random UUID names, so they never change in place.
	@immutable path /build/* /storage/photos/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
