{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /var/www/html/public
	encode zstd gzip
	request_body {
		max_size 110MB
	}

	# Vite assets are content-hashed and photos have random UUID names, so they never change in place.
	@immutable path /build/* /storage/photos/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
