APP_NAME="Sarah's Recipe Box"
APP_URL=http://localhost:8086
APP_PORT=8086
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Set to * when behind a reverse proxy (the Apache in front of Caddy) so X-Forwarded-Proto is trusted.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=debug

DB_ROOT_PASSWORD=root
DB_DATABASE=recipes
DB_USERNAME=recipes
DB_PASSWORD=secret

# Nightly backup retention (archives kept in ./backups)
BACKUP_KEEP=14

# Used by `php artisan recipes:create-owner` when no arguments are given.
OWNER_NAME=Sarah
OWNER_EMAIL=sarah@example.test
OWNER_PASSWORD=change-me-please
