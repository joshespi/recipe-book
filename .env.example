APP_NAME="Sarah's Recipe Box"
APP_URL=http://localhost:8086
APP_PORT=8086
# Apache runs on another machine, so Caddy must accept connections from the network.
# Keep the port closed to everyone except that machine (firewall: allow only Apache's address to APP_PORT).
# Use 127.0.0.1 instead if Apache runs on the same machine as these containers (for example local development).
APP_BIND=0.0.0.0
# Your local time zone (https://www.php.net/timezones). Set it before you start logging recipes:
# "I made this" dates and the nightly backup time follow it.
APP_TIMEZONE=UTC

# --- Development defaults. On the server use: APP_ENV=production, APP_DEBUG=false, and an https APP_URL. ---
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# The address(es) of the Apache machine, as this server sees them: comma separated, IPs or CIDR ranges
# (192.168.1.20  or  10.0.0.0/24). Laravel only believes "this request was https" and the visitor's real address
# when the connection comes from one of these. Leave empty for local development without Apache.
# Use * only if the firewall already restricts who can reach APP_PORT.
TRUSTED_PROXIES=
# Caddy needs to trust Apache too, space separated. The default (private networks) is right when Apache has a
# private address (192.168.x.x, 10.x.x.x, 172.16-31.x.x). If Apache connects from a public address, list it here.
CADDY_TRUSTED_PROXIES=private_ranges
# On the server (https): set to true so the login cookie is never sent over plain http.
SESSION_SECURE_COOKIE=

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=debug

DB_ROOT_PASSWORD=root
DB_DATABASE=recipes
DB_USERNAME=recipes
DB_PASSWORD=secret

# Nightly backup retention (archives kept in ./backups)
BACKUP_KEEP=14

# Used by `php artisan recipes:create-owner` when no options are given. Only the app container sees these.
OWNER_NAME=Sarah
OWNER_EMAIL=sarah@example.test
OWNER_PASSWORD=change-me-please
